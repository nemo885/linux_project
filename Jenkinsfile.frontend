pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Lint') {
            steps {
                dir('frontend') {
                    sh 'npm ci'
                    sh 'npm run lint'
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                echo "Building todo-frontend:latest from frontend/"
                script {
                    dockerImage = docker.build("todo-frontend:latest", "frontend")
                }
            }
        }
    }

    post {
        always {
            echo "Pipeline finished"
            sh 'docker image prune -f'
        }
    }
}
